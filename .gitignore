# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/

# Rust
target/
**/*.rs.bk

# Tauri (generated on build)
apps/*/src-tauri/gen/

# Node / Frontend
node_modules/
apps/*/ui/dist/
apps/*/ui/.svelte-kit/
npm-debug.log*

# Local configuration / secrets (e.g. location, API keys)
.env
.env.*
config.local.*

# Firmware binaries (no vendor firmware in the repo)
firmware/**/*.bin
firmware/**/*.hex
firmware/**/*.dfu

# Editors & IDEs
.vscode/
.idea/
*.swp

# Operating system
Thumbs.db
desktop.ini
.DS_Store
