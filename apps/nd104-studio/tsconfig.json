{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte"]
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte", "installer-ui/src/**/*.ts", "installer-ui/src/**/*.svelte"]
}
