{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nd104-sync",
  "identifier": "io.github.mrurdam.nd104-sync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "MrUrdam",
    "homepage": "https://github.com/MrUrdam/chilkey_nd104_utilities",
    "category": "Utility",
    "copyright": "MIT License",
    "license": "MIT",
    "shortDescription": "Time and weather for the Chilkey ND104 keyboard display",
    "longDescription": "Background tray app that keeps the display of the Chilkey ND104 keyboard supplied with the current time and weather. Wired USB connection only. Unofficial, not affiliated with Chilkey.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
